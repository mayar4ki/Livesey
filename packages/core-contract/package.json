{
  "name": "@acme/core-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.js"
    },
    "./utils/sourcify-verification": {
      "types": "./src/utils/sourcify-verification/sourcify-verification.ts",
      "import": "./dist/utils/sourcify-verification/sourcify-verification.cjs",
      "require": "./dist/utils/sourcify-verification/sourcify-verification.js"
    }
  },
  "scripts": {
    "build": "hardhat compile && tsx scripts/extract-abi.ts artifacts/contracts && tsup",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "clear": " rm -rf cache/ artifacts/ ignition/deployments/",
    "clean": "git clean -xdf .cache .turbo dist node_modules && rm -rf cache/ artifacts/ ignition/deployments/",
    "deploy:sepolia": "dotenv -e .env.sepolia -- hardhat run scripts/deploy.ts --network sepolia",
    "deploy:local": "dotenv -e .env.local -- hardhat run scripts/deploy.ts --network local",
    "verify:sepolia": "dotenv -e .env.sepolia -- hardhat run scripts/verify.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.3",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.2",
    "@nomicfoundation/hardhat-mocha": "^3.0.7",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.2",
    "@nomicfoundation/hardhat-typechain": "^3.0.1",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "catalog:",
    "chai": "^6.2.1",
    "dotenv-cli": "catalog:",
    "ethers": "^6.15.0",
    "hardhat": "^3.0.9",
    "mocha": "^11.7.5",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.3",
    "@nomicfoundation/hardhat-keystore": "^3.0.2",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.4",
    "@nomicfoundation/hardhat-verify": "^3.0.4",
    "@nomicfoundation/ignition-core": "^3.0.3",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "hardhat": "^3.0.10",
    "zod": "catalog:"
  },
  "license": "MIT"
}
