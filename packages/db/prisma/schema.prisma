// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma/schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DeployedToken {
  id              String @id @default(cuid())
  contractAddress String @db.VarChar(42) // Ethereum address (0x + 40 hex chars)
  chainId         Int

  name         String
  assetRefHash String @db.VarChar(66) // Asset reference hash (0x + 64 hex chars)
  symbol       String
  totalSupply  String // Store as string to handle large numbers (uint256)

  transactionHash String    @db.VarChar(66) // Transaction hash (0x + 64 hex chars)
  blockNumber     BigInt
  deployerAddress String    @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)
  verifiedAt      DateTime?
  deployedAt      DateTime  @default(now())

  seedData  TokenSeedData?
  proposals Proposal[]

  @@unique([contractAddress, chainId])
  @@index([contractAddress])
  @@index([chainId])
  @@index([deployedAt])
  @@index([verifiedAt])
  @@index([deployerAddress])
  @@index([blockNumber])
  @@index([transactionHash])
  @@map("deployed_tokens")
}

model TokenSeedData {
  id        String   @id @default(cuid())
  seedData  Json // Asset reference seed data (key-value pairs)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deployedToken   DeployedToken @relation(fields: [deployedTokenId], references: [id], onDelete: Cascade)
  deployedTokenId String        @unique

  @@map("token_seed_data")
}

model Proposal {
  id          String @id @default(cuid())
  title       String
  description String @db.Text

  creatorAddress String @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)

  duration    Int // Duration in seconds
  blockNumber BigInt // Block number when proposal was created
  createdAt   DateTime @default(now())
  expiresAt   DateTime // Calculated: createdAt + duration

  deployedToken   DeployedToken @relation(fields: [deployedTokenId], references: [id], onDelete: Cascade)
  deployedTokenId String

  votes Vote[]

  @@index([deployedTokenId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([blockNumber])
  @@map("proposals")
}

model Vote {
  id String @id @default(cuid())

  voterAddress String  @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)
  votingPower  BigInt // Voting power (token balance or delegated power)
  choice       Boolean // true = yes/for, false = no/against

  createdAt DateTime @default(now())

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String

  @@unique([proposalId, voterAddress]) // Prevent double voting
  @@index([proposalId])
  @@index([voterAddress])
  @@index([createdAt])
  @@map("votes")
}
