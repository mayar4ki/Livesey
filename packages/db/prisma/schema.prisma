// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma/schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id String @id @default(cuid())

  token String @db.VarChar(42) // Ethereum address (0x + 40 hex chars)

  name        String
  symbol      String
  totalSupply String // Store as string to handle large numbers (uint256)

  assetRefHash String @db.VarChar(66) // Asset reference hash (0x + 64 hex chars)
  operator     String @db.VarChar(42) // Ethereum address (0x + 40 hex chars)
  createdBy    String @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)

  chainId         Int
  transactionHash String @db.VarChar(66) // Transaction hash (0x + 64 hex chars)
  blockNumber     BigInt

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  seedData    SeedData?
  proposals   Proposal[]
  limitOrders LimitOrder[]

  @@unique([token, chainId])
  @@index([token])
  @@index([chainId])
  @@index([createdAt])
  @@index([verifiedAt])
  @@index([createdBy])
  @@index([blockNumber])
  @@map("tokens")
}

model SeedData {
  id        String   @id @default(cuid())
  data      Json // Asset reference seed data (key-value pairs)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId String @unique

  @@map("token_seed_data")
}

model Proposal {
  id String @id @default(cuid())

  title       String
  description String @db.Text
  duration    Int // Duration in seconds
  createdBy   String @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)

  blockNumber BigInt // Block number when proposal was created

  createdAt DateTime @default(now())
  expiresAt DateTime // Calculated: createdAt + duration

  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId String

  votes Vote[]

  @@index([tokenId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([createdBy])
  @@index([blockNumber])
  @@map("proposals")
}

model Vote {
  id String @id @default(cuid())

  createdBy   String  @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)
  votingPower BigInt // Voting power (token balance or delegated power)
  choice      Boolean // true = yes/for, false = no/against

  createdAt DateTime @default(now())

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String

  @@unique([proposalId, createdBy]) // Prevent double voting
  @@index([proposalId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("votes")
}

model LimitOrder {
  id String @id @default(cuid())

  orderHash String @db.VarChar(66) // 1inch order hash (0x + 64 hex chars)
  maker     String @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)

  makeToken String @db.VarChar(42) // Token address being sold
  takeToken String @db.VarChar(42) // Token address being bought

  makeAmount String // Amount to sell (as string to handle uint256)
  takeAmount String // Amount to buy (as string to handle uint256)

  signature String @db.VarChar(132) // EIP712 signature (0x + 130 hex chars)

  nonce      BigInt // Order nonce
  expiration BigInt // Expiration timestamp (Unix timestamp)

  chainId Int // Chain ID where the order is valid

  status String @default("pending") // pending, filled, cancelled, expired

  // Optional relation to Token model (for makeToken or takeToken)
  token   Token?  @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  tokenId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type LimitOrderType

  @@unique([orderHash, chainId]) // Order hash is unique per chain
  @@index([type])
  @@index([maker])
  @@index([makeToken])
  @@index([takeToken])
  @@index([chainId])
  @@index([status])
  @@index([expiration])
  @@index([createdAt])
  @@map("limit_orders")
}

enum LimitOrderType {
  BUY
  SELL
}
