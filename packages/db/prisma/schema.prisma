// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma/schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DeployedToken {
  id              String    @id @default(cuid())
  contractAddress String    @db.VarChar(42) // Ethereum address (0x + 40 hex chars)
  chainId         Int
  name            String
  symbol          String
  totalSupply     String // Store as string to handle large numbers (uint256)
  transactionHash String    @db.VarChar(66) // Transaction hash (0x + 64 hex chars)
  blockNumber     BigInt
  deployerAddress String    @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)
  verifiedAt      DateTime?
  deployedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([contractAddress, chainId])
  @@index([contractAddress])
  @@index([chainId])
  @@index([deployedAt])
  @@index([verifiedAt])
  @@index([deployerAddress])
  @@index([blockNumber])
  @@index([transactionHash])
  @@map("deployed_tokens")
}
