// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma/schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id String @id @default(cuid())

  token String @db.VarChar(42) // Ethereum address (0x + 40 hex chars)

  name        String
  symbol      String
  totalSupply String // Store as string to handle large numbers (uint256)

  assetRefHash String @db.VarChar(66) // Asset reference hash (0x + 64 hex chars)
  operator     String @db.VarChar(42) // Ethereum address (0x + 40 hex chars)
  createdBy    String @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)

  chainId         Int
  transactionHash String @db.VarChar(66) // Transaction hash (0x + 64 hex chars)
  blockNumber     BigInt

  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  seedData  SeedData?
  proposals Proposal[]

  @@unique([token, chainId])
  @@index([token])
  @@index([chainId])
  @@index([createdAt])
  @@index([verifiedAt])
  @@index([createdBy])
  @@index([blockNumber])
  @@map("tokens")
}

model SeedData {
  id        String   @id @default(cuid())
  data      Json // Asset reference seed data (key-value pairs)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId String @unique

  @@map("token_seed_data")
}

model Proposal {
  id String @id @default(cuid())

  title       String
  description String @db.Text
  duration    Int // Duration in seconds
  createdBy   String @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)

  blockNumber BigInt // Block number when proposal was created

  createdAt DateTime @default(now())
  expiresAt DateTime // Calculated: createdAt + duration

  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tokenId String

  votes Vote[]

  @@index([tokenId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([createdBy])
  @@index([blockNumber])
  @@map("proposals")
}

model Vote {
  id String @id @default(cuid())

  createdBy   String  @db.VarChar(42) // Ethereum wallet address (0x + 40 hex chars)
  votingPower BigInt // Voting power (token balance or delegated power)
  choice      Boolean // true = yes/for, false = no/against

  createdAt DateTime @default(now())

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String

  @@unique([proposalId, createdBy]) // Prevent double voting
  @@index([proposalId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("votes")
}
