# Hardhat Configuration for Sepolia Network
# ----------------------------------------
# Copy this file to .env.sepolia and fill in your actual values
# This file is used for contract deployment and verification on Ethereum Sepolia testnet

# RPC URL for Ethereum Sepolia network
# Get a free RPC URL from providers like Alchemy, Infura, or QuickNode
CHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the wallet account used for deployment and verification
# IMPORTANT: Never commit your private key to version control
# Format: 64-character hexadecimal string (without 0x prefix)
ACCOUNT_PRIVATE_KEY=your_64_character_hex_private_key_here

# Etherscan API key for contract verification
# Get your API key from https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here
