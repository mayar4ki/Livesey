{
  "name": "@acme/smart-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scripts/verifyContract": {
      "default": "./dist/scripts/verifyContract.js",
      "types": "./dist/scripts/verifyContract.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --emitDeclarationOnly false && hardhat compile",
    "build": "tsc && hardhat compile",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "clear": "rm -rf cache/ artifacts/ ignition/deployments/",
    "deploy:sepolia": "dotenv -e .env.sepolia -- hardhat run scripts/deploy.ts --network sepolia"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "catalog:",
    "dotenv-cli": "^10.0.0",
    "hardhat": "^3.0.9",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@acme/helpers": "workspace:*",
    "@nomicfoundation/hardhat-ethers": "^4.0.2",
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.3",
    "@nomicfoundation/hardhat-keystore": "^3.0.2",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.1",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.4",
    "@nomicfoundation/hardhat-verify": "^3.0.4",
    "@nomicfoundation/ignition-core": "^3.0.3",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.0.10",
    "zod": "^4.1.12"
  },
  "license": "MIT"
}
